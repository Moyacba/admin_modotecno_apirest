// schema.prisma

// Configure the datasource to connect to MongoDB
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "./db"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Model for a product (main product that can have variants)
model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  barcode        String?
  sku            String
  name           String
  description    String
  brand          String
  provider       String
  costPrice      Float
  salePrice      Float
  promoPrice     Float
  percentPrice   Float
  stock          Int
  minStock       Int      @default(0)
  images         String[]
  specifications Json?
  attributes     Json? // Atributos consolidados (heredados + específicos)
  hasVariants    Boolean  @default(false)

  // Relaciones con Categoría y Subcategoría
  categoryId     String?      @db.ObjectId
  categoryRel    Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId  String?      @db.ObjectId
  subcategoryRel Subcategory? @relation(fields: [subcategoryId], references: [id])

  category String? // Respaldo para migración

  variants        ProductVariant[]
  compatibilities ProductCompatibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  name String  @unique
  key  String? @unique // Opcional para seeding estable

  attributes    CategoryAttribute[]
  subcategories Subcategory[]
  products      Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subcategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  key        String?  @unique // Opcional para seeding estable
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  deviceCompatible Boolean @default(false)

  attributes SubcategoryAttribute[]
  products   Product[]

  recommendationRules RecommendationRule[] @relation("SourceSubcategory")
  targetRules         RecommendationRule[] @relation("TargetSubcategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttributeDefinition {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String   @unique
  key     String?  @unique // Opcional para seeding estable
  type    String // select, multiselect, boolean, number
  options String[] // Para tipos select/multiselect

  categoryAttributes    CategoryAttribute[]
  subcategoryAttributes SubcategoryAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryAttribute {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String              @db.ObjectId
  category    Category            @relation(fields: [categoryId], references: [id])
  attributeId String              @db.ObjectId
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id])

  required   Boolean @default(false)
  filterable Boolean @default(true)
  position   Int     @default(0)
}

model SubcategoryAttribute {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  subcategoryId String              @db.ObjectId
  subcategory   Subcategory         @relation(fields: [subcategoryId], references: [id])
  attributeId   String              @db.ObjectId
  attribute     AttributeDefinition @relation(fields: [attributeId], references: [id])

  required   Boolean @default(false)
  filterable Boolean @default(true)
  position   Int     @default(0)
}

// Model for product variants
model ProductVariant {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  productId      String   @db.ObjectId
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode        String?
  sku            String
  name           String // Ej: "Funda Silicone Case Rosa"
  description    String?
  color          String? // Atributo específico para color
  design         String? // Atributo específico para diseño
  size           String? // Atributo específico para talla
  material       String? // Atributo específico para material
  costPrice      Float
  salePrice      Float
  promoPrice     Float?
  percentPrice   Float?
  stock          Int
  minStock       Int      @default(0)
  images         String[]
  specifications Json?
  attributes     Json? // Atributos específicos de la variante
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DeviceBrand {
  id     String        @id @default(auto()) @map("_id") @db.ObjectId
  name   String        @unique
  models DeviceModel[]
}

model DeviceModel {
  id      String      @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  brandId String      @db.ObjectId
  brand   DeviceBrand @relation(fields: [brandId], references: [id])

  compatibilities ProductCompatibility[]
}

model ProductCompatibility {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  productId     String      @db.ObjectId
  product       Product     @relation(fields: [productId], references: [id])
  deviceModelId String      @db.ObjectId
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id])
}

model RecommendationRule {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  sourceSubcategoryId String      @db.ObjectId
  sourceSubcategory   Subcategory @relation("SourceSubcategory", fields: [sourceSubcategoryId], references: [id])
  targetSubcategoryId String      @db.ObjectId
  targetSubcategory   Subcategory @relation("TargetSubcategory", fields: [targetSubcategoryId], references: [id])

  ruleType        String // attributeMatch, deviceMatch, categoryCrossSell
  matchAttributes Json? // Array de nombres de atributos a comparar
}

// Model for a customer
model Customer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String   @unique
  password        String
  address         Json
  phone           String
  purchaseHistory String[]
  serviceHistory  String[]
}

// Model for a sale
model Sale {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String
  details    String
  date       DateTime
  products   Json
  total      Float
  discount   Float
  payments   Json?

  cashRegisterSessionId String?              @db.ObjectId
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
}

model Expense {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  product    String
  details    String?
  amount     Float
  method     String?
  date       DateTime
  category   String?
  categoryId Int?
  provider   String?
  ticketUrl  String?

  cashRegisterSessionId String?              @db.ObjectId
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
}

// Model for a cashflow

// Enums para categorizar datos
enum InteractionType {
  VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  PURCHASE
  WISHLIST
  SEARCH
}

enum FeedbackType {
  ORDER
  SERVICE
  WEBSITE
  PRODUCT
  OTHER
}

enum CommunicationChannel {
  EMAIL
  SMS
  WHATSAPP
  PHONE
  PUSH_NOTIFICATION
}

enum DeviceStatus {
  FUNCIONANDO
  CON_FALLAS
  NO_ENCIENDE
  PANTALLA_ROTA
  BATERIA_DAÑADA
  MOJADO
  OTROS
}

enum CustomerSegment {
  VIP
  FRECUENTE
  OCASIONAL
  NUEVO
  INACTIVO
}

enum CashMovementType {
  INGRESO_MANUAL
  RETIRO_MANUAL
  GASTO
  VENTA
}

enum SessionStatus {
  OPEN
  CLOSED
}

// Modelo de Comprador (Buyer)
model Buyer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Información Personal Básica
  nombre           String
  apellido         String?
  email            String    @unique
  dni              String?
  cuit             String? // CUIT/CUIL opcional
  telefono         String?
  whatsapp         String? // Número de WhatsApp específico
  fecha_nacimiento DateTime?

  // Dirección(es) del cliente
  direccion String

  // Información de Marketing y Adquisición
  acquisition_channel String? // ej: "google_ads", "facebook", "referido", "organico"
  utm_source          String?
  utm_medium          String?
  utm_campaign        String?
  utm_content         String?
  utm_term            String?

  // Preferencias de Comunicación
  communication_preferences CommunicationPreferences?

  // Segmentación y Tags
  segment CustomerSegment @default(NUEVO)
  tags    String[] // Tags personalizables

  // Metadatos
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  last_interaction DateTime?

  // Relaciones existentes
  orders   Order[]
  posSales POSSale[]

  // Nuevas relaciones para recopilación de datos
  devices        CustomerDevice[]
  interactions   ProductInteraction[]
  browsingEvents BrowsingEvent[]
  feedback       Feedback[]
  services       Service[]            @relation("CustomerServices")
}

// Modelo para preferencias de comunicación
model CommunicationPreferences {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String @unique @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  email_marketing        Boolean @default(true)
  email_transaccional    Boolean @default(true)
  sms_marketing          Boolean @default(false)
  sms_transaccional      Boolean @default(true)
  whatsapp_marketing     Boolean @default(true)
  whatsapp_transaccional Boolean @default(true)
  llamadas_comerciales   Boolean @default(false)

  preferred_channel CommunicationChannel @default(EMAIL)
  best_contact_time String? // ej: "mañana", "tarde", "noche"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo para dispositivos registrados por cliente
model CustomerDevice {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Información del dispositivo
  marca        String
  modelo       String
  numero_serie String?
  imei         String?
  color        String?
  capacidad    String?

  // Estado y observaciones
  fecha_compra  DateTime?
  lugar_compra  String?
  precio_compra Float?

  // Garantía
  tiene_garantia Boolean   @default(false)
  garantia_hasta DateTime?

  // Metadatos
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con servicios
  services Service[] @relation("DeviceServices")
}

// Modelo para interacciones con productos (vistas, carrito, etc.)
model ProductInteraction {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  productoId   String
  productoName String
  tipo         InteractionType

  // Contexto de la interacción
  session_id String?
  user_agent String?
  ip_address String?
  referrer   String?

  // Datos adicionales (como cantidad en carrito)
  quantity             Int?
  price_at_interaction Float?

  createdAt DateTime @default(now())
}

// Modelo para eventos de navegación en el e-commerce
model BrowsingEvent {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String? @db.ObjectId
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  // Información de la sesión
  session_id String
  page_url   String
  page_title String?
  time_spent Int? // segundos en la página

  // Información técnica
  user_agent  String?
  ip_address  String?
  referrer    String?
  device_type String? // mobile, desktop, tablet

  createdAt DateTime @default(now())
}

// Modelo para feedback y encuestas
model Feedback {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  tipo       FeedbackType
  rating     Int? // 1-5 estrellas
  comentario String? // Texto libre del feedback

  // Contexto del feedback
  related_order_id   String?
  related_service_id String?
  related_product_id String?

  // Respuesta del equipo
  respuesta       String?
  respondido_por  String?
  fecha_respuesta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo de Orden (Order)
model Order {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  buyerId String @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  // Fechas y estado
  fecha_creacion  DateTime  @default(now())
  fecha_pagado    DateTime? // Cuándo se pagó efectivamente
  fecha_enviado   DateTime?
  fecha_entregado DateTime?

  // Montos
  monto_total        Int // en centavos
  subtotal           Int? // sin envío ni descuentos
  descuento_aplicado Float @default(0)
  costo_envio        Float @default(0)

  // Estado y pagos
  estado                  String // PENDIENTE_PAGO, PAGADO, ENVIADO, COMPLETADO, CANCELADO
  metodo_pago             String
  id_transaccion_pasarela String?

  // Información de envío
  info_envio            Json?
  provincia             String?
  codigo_postal         String?
  tiempo_estimado_envio String?

  // Canal y marketing
  canal_venta    String  @default("ECOMMERCE")
  utm_source     String?
  utm_medium     String?
  utm_campaign   String?
  utm_content    String?
  utm_term       String?
  cupon_aplicado String?

  // Tracking técnico
  session_id  String?
  device_type String? // mobile, desktop, tablet
  user_agent  String?
  ip_address  String?

  // Comportamiento del usuario
  tiempo_desde_primer_producto_agregado Int? // en segundos
  cantidad_productos_vistos             Int?
  abandono_carrito_previo               Boolean @default(false)

  // Relaciones
  detalles OrderDetail[]
}

// Modelo de Detalle de Orden (OrderDetail)
model OrderDetail {
  id                                   String @id @default(auto()) @map("_id") @db.ObjectId
  orderId                              String
  order                                Order  @relation(fields: [orderId], references: [id])
  productoId                           String
  productoName                         String
  cantidad                             Int
  precio_unitario_al_momento_de_compra Int
}

// Modelo de Venta POS (POSSale)
model POSSale {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  buyerId        String          @db.ObjectId
  buyer          Buyer           @relation(fields: [buyerId], references: [id])
  fecha_creacion DateTime        @default(now())
  monto_total    Int // en centavos
  descuento      Int // en centavos
  estado         String // COMPLETADO
  metodo_pago    Json? // [{method: "cash", amount: 2000}, {method: "qr", amount: 2000}]
  detalles       POSSaleDetail[]

  cashRegisterSessionId String?              @db.ObjectId
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
}

// Modelo de Detalle de Venta POS (POSSaleDetail)
model POSSaleDetail {
  id                                   String  @id @default(auto()) @map("_id") @db.ObjectId
  posSaleId                            String  @db.ObjectId
  posSale                              POSSale @relation(fields: [posSaleId], references: [id])
  productoId                           String
  productoName                         String
  cantidad                             Int
  precio_unitario_al_momento_de_compra Int // en centavos
}

// Modelo de Servicio Técnico extendido
model Service {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relaciones con cliente y dispositivo
  buyerId String? @db.ObjectId
  buyer   Buyer?  @relation("CustomerServices", fields: [buyerId], references: [id], onDelete: SetNull)

  customerDeviceId String?         @db.ObjectId
  customerDevice   CustomerDevice? @relation("DeviceServices", fields: [customerDeviceId], references: [id], onDelete: SetNull)

  // Información del dispositivo (si no está registrado)
  device Json // información del dispositivo
  client Json // información del cliente (para retrocompatibilidad)

  // Estados del servicio
  state String // Estados: INGRESADO, EN_DIAGNOSTICO, PRESUPUESTADO, etc.

  // Información técnica detallada
  diagnostico                    String?
  estado_dispositivo_al_ingresar DeviceStatus?
  observaciones                  String?

  // Reparación y piezas
  repair String // descripción de la reparación
  piezas Json? // array de piezas utilizadas con precios

  // Información financiera
  total    Float
  discount Float?

  // Fechas importantes
  date              DateTime // fecha de ingreso
  dateOut           DateTime? // fecha de entrega
  fecha_presupuesto DateTime?
  fecha_aprobacion  DateTime?

  // Garantía de reparación
  garantia_hasta         DateTime?
  observaciones_garantia String?

  // Reingreso por Garantía
  warrantyReturnDate   DateTime?
  warrantyReturnReason String?

  // Pagos
  payments Json?
}

model CashRegisterSession {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  openedAt DateTime  @default(now())
  closedAt DateTime?

  initialCash Float // Monto inicial en caja al abrir

  // Datos calculados al cierre (snapshot)
  finalCashCalculated Float? // Lo que el sistema dice que debería haber en efectivo
  finalCashCounted    Float? // Lo que el usuario cuenta físicamente
  difference          Float? // Diferencia

  status SessionStatus @default(OPEN)

  openedBy String? // ID o Nombre del usuario
  closedBy String?

  observations String?

  // Relaciones
  movements CashMovement[]
  sales     POSSale[]
  expenses  Expense[]

  // Nota: Podríamos linkear ventas web (Sale) si quisiéramos, pero por ahora POSSale es lo crítico de caja.
  salesWeb Sale[]
}

model CashMovement {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  cashRegisterSessionId String              @db.ObjectId
  cashRegisterSession   CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id])

  type        CashMovementType
  amount      Float
  description String
  date        DateTime         @default(now())

  userId String? // Quién hizo el movimiento
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  username String?
  email    String  @unique
  password String
  avatar   String?
  sucursal String?
}

type PaymentMethod {
  amount Float
  method String
}

model FavoriteImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String   @unique
  createdAt DateTime @default(now())
}

model StockEntry {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime @default(now())
  observations String?

  // Cabecera de Compra — para auditoría y analíticas
  provider        String? // Nombre del proveedor
  paymentMethod   String? // efectivo | transferencia | tarjeta | cuenta_corriente
  userId          String? // ID/nombre del usuario que registró
  totalCost       Float? // Total en ARS (calculado al guardar)
  totalUnits      Int? // Suma de todas las cantidades (calculado al guardar)
  exchangeRateUSD Float? // Tipo de cambio USD al momento
  auditNotes      String? // Notas de auditoría

  items StockEntryItem[]
}

model StockEntryItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  stockEntryId String     @db.ObjectId
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)

  productId   String  @db.ObjectId
  isVariant   Boolean @default(false)
  productName String
  sku         String

  quantity  Int
  costPrice Float?

  // Campos de rentabilidad — capturados al momento del ingreso
  salePriceAtMoment Float? // Precio de venta vigente al ingresar
  categoryId        String? // Categoría del producto (denormalizado)
  categoryName      String? // Nombre de categoría (denormalizado)
  profitMargin      Float? // ((salePrice - costPrice) / salePrice) * 100
}

model Provider {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  contact   String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
